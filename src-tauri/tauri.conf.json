{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "AgentCue",
  "version": "0.1.1",
  "identifier": "dev.agent-ing.app",
  "build": {
    "beforeDevCommand": "node scripts/build-hook.mjs && pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build && node scripts/build-hook.mjs --release",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
